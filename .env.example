# Poker App Configuration
# Copy this to .env and edit as needed

# Public URL of your server (leave empty if using same domain/port)
# Example: https://poker.yourdomain.com
VITE_SERVER_URL=

# Port mapping configuration for Docker deployment
# PORT is the internal port the Node server listens on (default: 3001)
PORT=3001
# SERVER_PORT is the external port on the host mapped to the server (default: 3003)
SERVER_PORT=3003
# CLIENT_PORT is the external port on the host mapped to the client (default: 8982)
CLIENT_PORT=8982

# How many hours before an inactive lobby is cleaned up (default: 24)
LOBBY_TIMEOUT_HOURS=24

# Maximum number of concurrent lobbies (default: 5)
MAX_LOBBIES=5
